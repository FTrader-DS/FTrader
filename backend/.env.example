# .env.example — 이 파일을 복사해서 .env로 만든 뒤 값을 채우세요
# cp .env.example .env

# ── 데이터베이스 ────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ── JWT ─────────────────────────────────────────
# 256비트(32자) 이상의 랜덤 문자열 사용
JWT_SECRET=your-256bit-secret-key-here-must-be-at-least-32-chars

# ── 카카오 OAuth2 ────────────────────────────────
# 카카오 개발자 콘솔 → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_CLIENT_ID=your_kakao_rest_api_key

# 카카오 개발자 콘솔 → 앱 설정 → 보안 → 클라이언트 시크릿 코드
# 비활성화 상태면 빈 값으로 두세요
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# 카카오 개발자 콘솔 → 앱 설정 → 카카오 로그인 → Redirect URI 에 등록된 값
# 방식 A: 백엔드가 콜백을 처리
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# ── 프론트엔드 ──────────────────────────────────
# 로그인 성공 후 JWT를 전달할 프론트엔드 주소
FRONTEND_URL=http://localhost:5173
